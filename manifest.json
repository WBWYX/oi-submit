{
  "manifest_version": 3,
  "name": "OI Submit",
  "version": "0.1.0",
  "description": "把 OI Bench 里的代码提交到洛谷 / Codeforces / AtCoder / Timus / QOJ / 牛客 / LibreOJ，可选语言与 O2，回传评测结果，并按链接抓取题面。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.luogu.com.cn/*",
    "https://codeforces.com/*",
    "https://atcoder.jp/*",
    "https://acm.timus.ru/*",
    "https://qoj.ac/*",
    "https://ac.nowcoder.com/*",
    "https://loj.ac/*",
    "https://api.loj.ac/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.luogu.com.cn/*",
        "https://codeforces.com/*",
        "https://atcoder.jp/*",
        "https://acm.timus.ru/*",
        "https://qoj.ac/*",
        "https://ac.nowcoder.com/*",
        "https://loj.ac/*"
      ],
      "js": [
        "src/content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/shared/*.js",
        "src/shared/statement/*.js"
      ],
      "matches": [
        "https://www.luogu.com.cn/*",
        "https://codeforces.com/*",
        "https://atcoder.jp/*",
        "https://acm.timus.ru/*",
        "https://qoj.ac/*",
        "https://ac.nowcoder.com/*",
        "https://loj.ac/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "OI Submit"
  },
  "options_page": "src/options.html"
}
